# Server Configuration
NODE_ENV=development
PORT=5001
HOST=localhost

# API Configuration
API_VERSION=v1

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=AquaSense
DB_USER=postgres
DB_PASSWORD=<local-database-password>
DB_DIALECT=postgres

# JWT / Cookie Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<minimum-32-character-secret>
JWT_EXPIRY=24h
AUTH_COOKIE_NAME=aquasense_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_MAX_AGE_MS=86400000

# MQTT Configuration (ESP32 -> Backend)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_READINGS=water/esp32/readings
MQTT_TOPIC_SENSOR_WILDCARD=aquasense/+
MQTT_TOPIC_COMMANDS=water/commands/#
MQTT_TOPIC_STATUS=water/esp32/status
# Set MQTT_USERNAME and MQTT_PASSWORD only when the broker requires authentication.
MQTT_USERNAME=
MQTT_PASSWORD=
# Oxygen must be supplied by a sensor; omitted oxygen is marked unmeasured.

# SMS / Farm Alerts (optional integration; API starts without these values)
# SMS_PROVIDER picks the gateway: iprogsms (default), semaphore, or unisms. Only the selected provider's keys are used.
SMS_PROVIDER=iprogsms
# IPROG SMS (iprogsms.com): API token from https://www.iprogsms.com/account/token. Philippine numbers only.
IPROG_SMS_API_TOKEN=<your-iprog-sms-api-token>
# Optional: IPROG network route 0, 1, or 2 (2 is recommended for broad PH coverage).
IPROG_SMS_NETWORK_PROVIDER=2
# Optional override if IPROG publishes a different API host.
# IPROG_SMS_BASE_URL=https://www.iprogsms.com/api/v1
# Semaphore (semaphore.co): API key from the Semaphore dashboard. Philippine numbers only.
SEMAPHORE_API_KEY=<your-semaphore-api-key>
# Optional: a sender name approved on your Semaphore account. Leave blank to use the account default.
SEMAPHORE_SENDER_NAME=
# UniSMS (unismsapi.com)
UNISMS_API_SECRET_KEY=<your-unisms-secret>
# Required to send SMS when SMS_PROVIDER=unisms. New accounts use Unisoft (Globe and DITO).
UNISMS_SENDER_ID=<your-approved-sender-id>
FARMER_NAME=Farmer
# Leave blank until you enter the real farmer mobile in +639XXXXXXXXX format.
FARMER_PHONE=
FARM_NAME=AquaSense Farm
TANK_NAME=MainTank

# Feeding
FEEDER_DEVICE_ID=esp32-feeder-1
FEEDING_TIMEZONE=Asia/Manila

# Device API keys, comma-separated as device-id:key
DEVICE_KEYS=tank-001:replace-with-device-key

# Development-only device ingestion bypass. Keep false unless deliberately testing without keys.
ALLOW_UNAUTHENTICATED_DEVICES=false
